{
  "manifest_version": 3,
  "name": "Translation Extension (Anh - Việt - Trung)",
  "version": "1.0.0",
  "description": "Dịch qua lại giữa tiếng Anh, Việt, Trung kèm IPA/Pinyin offline và phát âm.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "<all_urls>",
    "file://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "popup.css"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "pdf-viewer/viewer.html",
        "pdf.min.mjs",
        "pdf.worker.min.mjs",
        "onnxruntime-web/*"
      ],
      "matches": [
        "<all_urls>",
        "file://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/index.html"
  }
}
